# Painel /admin
# Fine-grained Personal Access Token do GitHub com acesso SOMENTE a este repositório
# e permissão Repository permissions > Contents: Read and write.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxx

# Senha que a dona da Brasinha usará em /admin.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Opcional. Se não preencher, o próprio GITHUB_TOKEN é usado para assinar a sessão.
SESSION_SECRET=

# Fila criptografada usada pelo Brasinha Print Agent.
# Use um valor longo e aleatório e copie o MESMO valor para print-agent/config.json no PC da pizzaria.
PRINT_QUEUE_SECRET=troque-por-um-segredo-longo-e-aleatorio
PRINT_QUEUE_ISSUE=1

# Opcionais — estes já são os padrões do código.
GITHUB_REPO=AdrielSchimit/Brasinha.Digital
GITHUB_BRANCH=main
