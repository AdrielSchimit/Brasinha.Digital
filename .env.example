# Painel /admin
# Use um Fine-grained Personal Access Token do GitHub com acesso apenas a este repositório
# e permissão Contents: Read and write.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxx

# Senha que a dona da Brasinha usará em /admin.
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Segredo aleatório para assinar a sessão. Ex.: 32+ caracteres aleatórios.
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Opcionais — os valores abaixo já são os padrões do código.
GITHUB_REPO=AdrielSchimit/Brasinha.Digital
GITHUB_BRANCH=main
